# Supabase 연결 시 두 값을 모두 설정하세요. service_role 키는 절대 사용하지 마세요.
# URL은 https://프로젝트주소.supabase.co 형태의 기본 주소를 입력하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 실제 운영 배포는 false. 개발 서버와 localhost에서는 체험 모드가 기본 허용됩니다.
VITE_ENABLE_DEMO=false
# 업체에게 보내는 새 PO의 접속 링크. OAuth 콜백 주소 설정과는 별개입니다.
VITE_PUBLIC_APP_URL=https://sig-td.vercel.app
