# Server/CLI only. Never put these values in Vercel VITE_* variables or source control.
# Copy to a private file outside the repository and protect it with chmod 600.
SUPABASE_URL=https://SOURCE_PROJECT_REF.supabase.co
SUPABASE_DB_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.SOURCE_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=
SIG_BACKUP_PASSPHRASE=
# Generate a random passphrase with: openssl rand -base64 48
# Keep the passphrase in a separate password manager. Losing it makes backups unreadable.
SIG_BACKUP_DIRECTORY=/tmp/sig-backups
SIG_BACKUP_MAX_BYTES=268435456
# PostgreSQL 17+ verifies the server certificate and hostname. Optional custom CA file:
# SUPABASE_DB_SSL_ROOT_CERT=/secure/path/supabase-source-ca.crt

# Restore only into a separate, new, empty project. Never use the production source here.
TARGET_SUPABASE_URL=https://RESTORE_PROJECT_REF.supabase.co
TARGET_SUPABASE_DB_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.RESTORE_PROJECT_REF.supabase.co:5432/postgres
TARGET_SUPABASE_SERVICE_ROLE_KEY=
# TARGET_SUPABASE_DB_SSL_ROOT_CERT=/secure/path/supabase-target-ca.crt
# Extra comma-separated project refs the restore command must never modify:
SIG_PROTECTED_PROJECT_REFS=
