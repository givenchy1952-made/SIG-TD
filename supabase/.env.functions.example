# Copy to .env.functions.local (ignored by git). Set real values ONLY on server.
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically. Do not set or upload them here.

# Resend account + verified sending domain required; no automatic domain setup.
RESEND_API_KEY=re_REPLACE_WITH_SERVER_ONLY_KEY
PO_FROM_EMAIL=FIVE SPACE / SIG <po@your-verified-domain.com>
# Exact browser origins, comma-separated, no wildcard and no trailing slash.
PO_ALLOWED_ORIGINS=https://YOUR_DEPLOYMENT.vercel.app,http://localhost:5173
